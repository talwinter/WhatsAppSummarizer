<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background_dark"
            app:titleTextColor="@color/text_primary" />

        <!-- Header: the one number that matters, plus live capture state -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/textHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Text.Display"
                android:text="@string/groups_headline" />

            <TextView
                android:id="@+id/textSubhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Text.Body"
                android:layout_marginTop="4dp"
                tools:text="12 groups · 1,204 messages captured" />

            <!-- Capture status. Tapping it opens notification-access settings. -->
            <LinearLayout
                android:id="@+id/layoutStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/pill_surface"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="9dp">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_avatar_background"
                    android:backgroundTint="@color/primary" />

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    tools:text="Capturing group messages" />

            </LinearLayout>

            <!-- Search -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchLayout"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/search_groups"
                app:boxBackgroundColor="@color/surface_dark"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:endIconMode="clear_text"
                app:endIconTint="@color/text_secondary"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Group list -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewChats"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="96dp"
                tools:listitem="@layout/item_chat" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:alpha="0.35"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_group"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/emptyStateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.SectionTitle"
                    android:layout_marginTop="20dp"
                    android:text="@string/empty_state_title" />

                <TextView
                    android:id="@+id/emptyStateText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Text.Body"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/empty_state_message" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCleanup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/cleanup_old_messages"
        android:text="@string/cleanup"
        android:textColor="@color/text_primary"
        app:backgroundTint="@color/surface_high"
        app:icon="@drawable/ic_cleanup"
        app:iconTint="@color/text_secondary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
